# Simple Texture Demo
# Easy scene to test XPM textures

A 0.2 255,255,255

C 0,0,20 0,0,-1 70

L -10,20,15 0.7 255,255,255

# Textured earth sphere (main focus)
sp 0,0,0 10 100,100,255 tx:textures/earth.xpm

# Checkerboard floor
pl 0,-12,0 0,1,0 200,200,200 ck

# Small colored accent spheres
sp -8,0,5 3 255,100,100
sp 8,0,5 3 100,255,100
