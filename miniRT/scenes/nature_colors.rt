# Esfera média - verde claro
sp -5,2,5 5 130,180,140 bump=1.2 buv=2.5,2.5

# Esfera pequena - bege natural
sp -10,-2,-2 3 220,210,195 bump=1.0 buv=3.0,3.0

# Cilindro - marrom madeira
cy 0,-5,8 0,1,0.2 3 12 120,90,70 bump=1.3 buv=2.0,1.5

# Cilindro pequeno - verde oliva
