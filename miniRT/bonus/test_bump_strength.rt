A 0.2 255,255,255
C 0,0,40 0,0,-1 70
L 40,10,40 1 255,255,255

# Esfera com bump map - intensidade padrão (1.0)
sp -15,0,10 8 255,255,255 tx:textures/earthmap1k.xpm bm:textures/earthbump1k.xpm

# Esfera com bump map - intensidade reduzida (0.3)
sp 0,0,10 8 255,255,255 tx:textures/earthmap1k.xpm bm:textures/earthbump1k.xpm bump=0.3

# Esfera com bump map - intensidade muito reduzida (0.1)
sp 15,0,10 8 255,255,255 tx:textures/earthmap1k.xpm bm:textures/earthbump1k.xpm bump=0.1

# Plano com bump map e intensidade personalizada
pl 0,-10,0 0,1,0 100,100,100 bm:textures/earthbump1k.xpm bump=0.5
