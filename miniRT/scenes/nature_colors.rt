# Cena verde natureza - Esquema verde/marrom/bege
A 0.3 240,250,245
C 0,5,25 0,-0.1,-1 70
L -20,30,15 0.7 255,255,250

# Plano base - verde musgo claro
pl 0,-10,0 0,1,0 200,215,190 bump=0.8 buv=0.8,0.8

# Plano fundo - verde suave
pl 0,0,-30 0,0,1 190,220,200

# Esfera grande - verde floresta
