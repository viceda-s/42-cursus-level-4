# MiniRT Scene with XPM Textures
# Format: object_type parameters tx:path/to/texture.xpm

A 0.2 255,255,255

C 0,0,20 0,0,-1 70

L -40,40,30 0.7 255,255,255

# Textured Earth sphere
sp 0,0,0 10 100,100,255 tx:textures/earth.xpm

# Regular colored sphere (no texture)
sp -15,0,5 8 255,100,100

# Textured plane (checkerboard-like)
pl 0,-10,0 0,1,0 200,200,200 ck

# Regular cylinder
cy 15,0,0 0,1,0 5 15 100,255,100
