# Cena minimalista - Esquema preto/branco/cinza
A 0.3 250,250,250
C 0,5,25 0,-0.1,-1 70
L -20,30,15 0.7 255,255,255

# Plano base - cinza médio
pl 0,-10,0 0,1,0 160,160,160 bump=0.8 buv=0.8,0.8

# Plano fundo - cinza claro
pl 0,0,-30 0,0,1 200,200,200

# Esfera grande - branco
sp 10,0,0 8 240,240,240 bump=1.5 buv=2.0,2.0

# Esfera média - cinza claro
sp -5,2,5 5 200,200,200 bump=1.2 buv=2.5,2.5

# Esfera pequena - cinza escuro
sp -10,-2,-2 3 100,100,100 bump=1.0 buv=3.0,3.0

# Cilindro - preto suave
cy 0,-5,8 0,1,0.2 3 12 60,60,60 bump=1.3 buv=2.0,1.5

# Cilindro pequeno - cinza médio
cy -12,0,0 0.2,1,0 2 8 140,140,140 bump=1.0 buv=2.0,2.0
